# Django 설정
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False

# 허용 호스트 (쉼표로 구분)
ALLOWED_HOSTS=tirepass.pythonanywhere.com,localhost,127.0.0.1

# ============================================
# 토스페이먼츠 설정 (필수)
# ============================================
# ⚠️ 보안: 실제 운영 키는 절대 Git에 커밋하지 마세요!
# PythonAnywhere → Web 탭 → Environment variables에서 설정
TOSS_PAYMENTS_CLIENT_KEY=live_ck_xxxxxxxxxxxxxxxxxxxxx
TOSS_PAYMENTS_SECRET_KEY=live_sk_xxxxxxxxxxxxxxxxxxxxx
TOSS_PAYMENTS_SECURITY_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# ERP API 설정 (필수)
# ============================================
ERP_SYNC_API_URL=http://itire2.iptime.org:8000
ERP_SYNC_API_KEY=your-erp-api-key-here

# ============================================
# 데이터베이스 설정 (로컬 개발용)
# ============================================
DB_NAME=itire_db
DB_USER=root
DB_PASSWORD=tirepass
DB_HOST=localhost
DB_PORT=3306

# ============================================
# CSRF 신뢰 도메인 (쉼표로 구분)
# ============================================
CSRF_TRUSTED_ORIGINS=https://tirepass.pythonanywhere.com,http://localhost:8000
